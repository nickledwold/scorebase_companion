<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181818"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="62px"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/greypanel_topbar" />

    <ImageView
        android:id="@+id/exercisePanel"
        android:layout_width="1040px"
        android:layout_height="65px"
        android:layout_marginStart="35dp"
        app:layout_constraintBottom_toTopOf="@+id/scorePanelImageView"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/bluepanel_exercise" />

    <Button
        android:id="@+id/submitButton"
        android:layout_width="727px"
        android:layout_height="195px"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="17dp"
        android:background="@drawable/submit_button_background"
        android:enabled="true"
        android:fontFamily="@font/sfprodisplaylight"
        android:onClick="submitButtonpressed"
        android:text="SUBMIT"
        android:textColor="@android:color/white"
        android:textSize="70sp"
        app:layout_constraintBottom_toTopOf="@+id/roleInfoPanel"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/deleteButton"
        android:layout_width="225px"
        android:layout_height="176px"
        android:layout_marginEnd="35dp"
        android:layout_marginBottom="15dp"
        android:adjustViewBounds="false"
        android:background="@drawable/keypad_button_pressed"
        android:contentDescription="delete button"
        android:drawableStart="@drawable/delete"
        android:drawablePadding="30dp"
        android:onClick="deleteButtonpressed"
        android:padding="40px"
        android:scaleType="fitCenter"
        android:src="@drawable/delete"
        android:textColor="@android:color/white"
        android:textSize="50sp"
        app:layout_constraintBottom_toTopOf="@+id/submitButton"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/otherInfoTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/sfprodisplayregular"
        android:maxLines="1"
        android:textAlignment="textEnd"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/exercisePanel"
        app:layout_constraintStart_toStartOf="@+id/exercisePanel"
        app:layout_constraintTop_toTopOf="@+id/exercisePanel" />

    <TextView
        android:id="@+id/numberTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/sfprodisplaylight"
        android:maxLines="1"
        android:textAlignment="textEnd"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@+id/exercisePanel"
        app:layout_constraintEnd_toEndOf="@+id/exercisePanel"
        app:layout_constraintTop_toTopOf="@+id/exercisePanel" />

    <ImageView
