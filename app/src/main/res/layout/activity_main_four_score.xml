        android:textAlignment="textEnd"
        android:textColor="@android:color/white"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="@+id/roleJudgePanel"
        app:layout_constraintEnd_toEndOf="@+id/roleJudgePanel"
        app:layout_constraintTop_toTopOf="@+id/roleJudgePanel"
